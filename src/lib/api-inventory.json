        "method": "POST",
        "summary": "Body: `{ backup }` — previews a merge: `{ added, existing, episodesAdded, episodesExisting }`."
      },
      {
        "method": "PUT",
        "summary": "Body: `{ backup }` — merges it into the library; same counts as the preview."
