# Required in wiki mode
DATABASE_URL="postgresql://user:password@host:5432/database"
ADMIN_SECRET="replace-me"

# `wiki` runs a knowledge base; `media` runs a film and series library.
# Set this and NEXT_PUBLIC_* before building; rebuild after changing them.
ARKIVEL_SITE_MODE="wiki"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# `folio` is the full-viewport interface; `wiki` keeps the classic framed skin.
NEXT_PUBLIC_ARKIVEL_SKIN="folio"

# Optional public branding
NEXT_PUBLIC_ARKIVEL_NAME="Arkivel"
NEXT_PUBLIC_ARKIVEL_DESCRIPTION="A focused, self-hosted home for durable knowledge."
# Leave blank to use "Welcome to <name>."
NEXT_PUBLIC_ARKIVEL_WELCOME_TEXT=""
NEXT_PUBLIC_ARKIVEL_LOGO="/brand/arkivel-logo.png"
NEXT_PUBLIC_ARKIVEL_LOGO_MARK="/brand/arkivel-logo.svg"
NEXT_PUBLIC_ARKIVEL_APP_ICON="/brand/arkivel-icon-512.png"

# Optional runtime module selection; blank uses the default enabled modules.
ARKIVEL_MODULES=""

# Optional file uploads
BLOB_READ_WRITE_TOKEN=""

# Optional, media module: a TMDB API read access token. Without it discovery
# searches the bundled starter catalogue only.
TMDB_API_KEY=""
# Optional, media site mode: OMDB for IMDb / Rotten Tomatoes / Metacritic
# ratings, and an Anthropic key for Claude-assisted mood picks (local matching
# is the fallback). Server-side only.
OMDB_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional OAuth (runtime only; never pass secrets as Docker build arguments).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
# Set to the deployment's public origin when enabling OAuth outside Compose.
# Compose defaults this to NEXT_PUBLIC_BASE_URL when left blank.
NEXTAUTH_URL=""

# Optional: let browser apps on other origins call /api with a personal
# access token (comma list of origins, or *). Cookies are never accepted
# cross-origin. Blank keeps the api same-origin only.
ARKIVEL_API_CORS_ORIGINS=""
